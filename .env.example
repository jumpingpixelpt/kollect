# Supabase (público — leitura do dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (servidor — escrita do pipeline)
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline de dados
TUBULAR_API_KEY=
APIFY_TOKEN=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Análise multimodal de vídeo (deep-scan) — Google AI Studio
GEMINI_KEY=
# opcional: troca o modelo (default gemini-2.5-pro)
GEMINI_MODEL=

# influencers.club — VENDOR PAGO, plano ANUAL de créditos (não mensal).
# Reservado à demografia de audiência, o único dado que só ele tem. Descoberta é Apify,
# transcrição é Groq. Ver "Créditos do influencers.club" no README antes de mexer.
INFLUENCERS_CLUB_API_KEY=
# piso de créditos: nenhuma chamada paga corre se deixar o saldo abaixo disto (default 50)
IC_CREDIT_FLOOR=
# =1 reabre a descoberta pelo IC (ic-sweep / ic-discover), desligada desde jul/2026.
# Foi ela que consumiu a maior parte do plano anual — não ligar sem orçamento aprovado.
IC_DISCOVERY_ENABLED=

# Segurança do cron
CRON_SECRET=

# Alertas de crescimento das squads (Resend; aplicar migration de notificações)
# O domínio do remetente precisa estar verificado no Resend. Preview nunca envia.
SQUAD_ALERTS_ENABLED=
RESEND_API_KEY=
SQUAD_EMAIL_FROM=
# Opcional; padrão https://www.kollect.online
SQUAD_APP_URL=
